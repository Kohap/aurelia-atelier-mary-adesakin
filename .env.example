# Auth stays off for the public atelier.
VITE_AUTH_ENABLED=false

# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored — never commit real secrets.

# Admin token — protects the catalogue publish and image upload endpoints.
# Both vars must be set to the same value. VITE_ is bundled into the client
# so the admin panel can send it; ADMIN_TOKEN is checked server-side.
ADMIN_TOKEN=
VITE_ADMIN_TOKEN=

# Paystack public key (safe in client bundle — prefixed with VITE_)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_

# Paystack currency. Use NGN until USD is enabled on your Paystack account.
# When Paystack approves USD: change to USD in Vercel env vars and redeploy — no code changes needed.
VITE_PAYSTACK_CURRENCY=NGN

# Paystack secret key (server-side only — Vercel API routes / functions)
PAYSTACK_SECRET_KEY=sk_test_

# Vercel Blob read/write token (server-side only — admin artwork uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_

# Resend — transactional email for order confirmations after payment.
# Sign up at resend.com, verify your domain, then set the from address.
# Without RESEND_API_KEY the webhook still works but sends no emails.
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=Mary Adesakin Studio <studio@yourdomain.com>
